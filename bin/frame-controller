#!/bin/sh
set -eu

controller_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

case "$(uname -m)" in
  x86_64) controller="$controller_dir/frame-controller-linux-amd64" ;;
  aarch64|arm64) controller="$controller_dir/frame-controller-linux-arm64" ;;
  *) echo "Unsupported system architecture" >&2; exit 1 ;;
esac

exec "$controller" "$@"
